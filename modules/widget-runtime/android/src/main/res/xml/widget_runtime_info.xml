<?xml version="1.0" encoding="utf-8"?>
<!-- Android enforces a 30-minute minimum. This refreshes local device-info values without frequent wakeups. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="110dp"
  android:minHeight="40dp"
  android:targetCellWidth="2"
  android:targetCellHeight="1"
  android:minResizeWidth="40dp"
  android:minResizeHeight="40dp"
  android:resizeMode="horizontal|vertical"
  android:widgetCategory="home_screen"
  android:initialLayout="@layout/widget_runtime_root"
  android:previewLayout="@layout/widget_runtime_root"
  android:description="@string/widget_runtime_description"
  android:updatePeriodMillis="1800000" />
