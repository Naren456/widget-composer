<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Glance renders WidgetSpec v1-v3 as adaptive Android home-screen widgets. -->
    <receiver
      android:name="expo.modules.widgetruntime.ComposerWidgetProvider"
      android:exported="true"
      android:label="@string/widget_runtime_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_runtime_info" />
    </receiver>
  </application>
</manifest>
