<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.widgetruntime" >

    <uses-sdk android:minSdkVersion="24" />

    <application>
        <receiver
            android:name="expo.modules.widgetruntime.LockScreenAdminReceiver"
            android:description="@string/widget_runtime_lock_admin_description"
            android:exported="true"
            android:label="@string/widget_runtime_lock_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN" >
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/widget_runtime_device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="expo.modules.widgetruntime.LockScreenActionReceiver"
            android:exported="false" />
        <!-- Glance renders WidgetSpec v1-v3 as adaptive Android home-screen widgets. -->
        <receiver
            android:name="expo.modules.widgetruntime.ComposerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_runtime_label" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_runtime_info" />
        </receiver>
        <receiver
            android:name="expo.modules.widgetruntime.ComposerWidgetProvider3x1"
            android:exported="true"
            android:label="@string/widget_runtime_label_3x1" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_runtime_info_3x1" />
        </receiver>
        <receiver
            android:name="expo.modules.widgetruntime.ComposerWidgetProvider4x1"
            android:exported="true"
            android:label="@string/widget_runtime_label_4x1" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_runtime_info_4x1" />
        </receiver>
        <receiver
            android:name="expo.modules.widgetruntime.ComposerWidgetProvider2x2"
            android:exported="true"
            android:label="@string/widget_runtime_label_2x2" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_runtime_info_2x2" />
        </receiver>
        <receiver
            android:name="expo.modules.widgetruntime.ComposerWidgetProvider4x2"
            android:exported="true"
            android:label="@string/widget_runtime_label_4x2" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_runtime_info_4x2" />
        </receiver>
    </application>

</manifest>