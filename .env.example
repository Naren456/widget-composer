# Public app settings — bundled into the app, so never put secrets here.
# Server secrets live in the backend: ~/Documents/widget-composer-backend/apps/api/.env

# Optional app override: http(s)://<ip-or-host>:<port>.
# Leave empty for development; the app uses the Expo dev server's host on port 3000.
# Set this to a publicly reachable API URL for release builds.
EXPO_PUBLIC_API_URL=
