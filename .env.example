# Server-only — read by the API route src/app/api/agent+api.ts, never bundled into the app.
# Do NOT prefix these with EXPO_PUBLIC_: that would ship them to every phone.
ANTHROPIC_API_KEY=
COMPOSIO_API_KEY=

# Optional comma-separated Composio toolkit allow-list for the agent.
# COMPOSIO_TOOLKITS=github,hackernews,youtube,reddit,googlecalendar

# Encrypts stored data-source credentials (AES-256-GCM). 32 random bytes, hex or base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes stored credentials unreadable; rotating it requires re-entering them.
CREDENTIAL_KEY=
# Optional: where the server keeps its data files (default .data)
# DATA_DIR=.data
