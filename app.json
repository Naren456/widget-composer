{
  "expo": {
    "name": "Widget Composer",
    "slug": "web2widgets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/icon.png",
    "scheme": "web2widgets",
    "userInterfaceStyle": "automatic",
    "android": {
      "icon": "./assets/app-icon/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#070C09",
        "foregroundImage": "./assets/app-icon/android-foreground.png",
        "monochromeImage": "./assets/app-icon/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.narendra78.web2widgets"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/app-icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070C09",
          "image": "./assets/app-icon/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "ComposerWidget",
              "displayName": "Widget Composer",
              "description": "Your most recently composed widget.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "horizontal",
                "initialLayout": "./src/home-screen-widget/composer-widget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.narendra78.web2widgets",
      "icon": {
        "light": "./assets/app-icon/ios-light.png",
        "dark": "./assets/app-icon/ios-dark.png",
        "tinted": "./assets/app-icon/ios-tinted.png"
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.narendra78.web2widgets.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.narendra78.web2widgets"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "54fc485c-56f8-459c-a630-97b6924d382c"
      }
    },
    "owner": "narendra78"
  }
}
